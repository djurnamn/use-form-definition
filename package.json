{
  "name": "use-form-definition",
  "version": "2.10.0",
  "description": "A UI-agnostic React form library that generates forms from simple field definitions with Zod validation and React Hook Form integration",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "cli",
    "src/components"
  ],
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.zod3.json",
    "test": "vitest --run && ZOD=3 vitest --run",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "prepublishOnly": "node -e \"console.error('A direct publish is refused: the release tooling publishes this package from the repository root, as a tarball stripped of maintainer notes and checked.'); process.exit(1)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0"
  },
  "bin": {
    "use-form-definition": "./cli/copy-components.js"
  },
  "keywords": [
    "react",
    "forms",
    "validation",
    "zod",
    "react-hook-form",
    "ui-agnostic",
    "typescript"
  ],
  "author": "Björn Djurnamn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djurnamn/use-form-definition.git"
  },
  "bugs": {
    "url": "https://github.com/djurnamn/use-form-definition/issues"
  },
  "homepage": "https://github.com/djurnamn/use-form-definition#readme",
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-hook-form": ">=7.55.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^23.0.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.68.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^1.0.0",
    "zod": "^4.6.7",
    "zod3": "npm:zod@^3.25.76"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  }
}
